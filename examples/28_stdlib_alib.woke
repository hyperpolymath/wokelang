// Test aggregate-library (aLib) functions

to main() {
    print("=== Testing aLib Functions ===");

    // Arithmetic
    remember sum = add(10, 5);
    remember diff = subtract(10, 5);
    remember product = multiply(10, 5);
    remember quotient = divide(10, 5);

    print("Arithmetic: add, subtract, multiply, divide work!");

    // Comparison
    remember isEqual = equal(5, 5);
    remember isLess = lessThan(3, 5);
    remember isGreater = greaterThan(7, 5);

    print("Comparison: equal, lessThan, greaterThan work!");

    // Logical
    remember andResult = and(true, false);
    remember orResult = or(true, false);
    remember notResult = not(false);

    print("Logical: and, or, not work!");

    // String
    remember combined = concat("Hello", " World");
    remember len = strLength("test");

    print("String: concat, strLength work!");

    // Math
    remember absVal = abs(-5);
    remember sqrtVal = sqrt(16.0);

    print("Math: abs, sqrt work!");

    print("=== All aLib Tests Complete! ===");
    give back 0;
}
