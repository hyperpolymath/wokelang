to main() {
    remember sum = 0;

    repeat 10 times {
        remember sum = sum + 1;
    }

    give back sum;
}

to factorial(n: Int) -> Int {
    remember result = 1;
    remember counter = n;

    repeat n times {
        remember result = result * counter;
        remember counter = counter - 1;
    }

    give back result;
}
