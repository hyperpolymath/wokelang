// Type definitions example
// Demonstrates custom structs and enums

// Define a simple struct
type Person = {
    name: String,
    age: Int
};

// Define an enum with variants
type Color = Red | Green | Blue | RGB(Int, Int, Int);

// Define a type alias
type UserId = Int;

to main() {
    print("Type definitions example:");

    // Use enum constructors
    remember primary = Red;
    print("Primary color created (nullary constructor)");

    remember custom = RGB(255, 128, 0);
    print("Custom RGB color created (constructor with args)");

    // Type alias usage
    remember id = 42;
    print("User ID: " + toString(id));

    give back 0;
}
