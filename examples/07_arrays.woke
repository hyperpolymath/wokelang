to main() {
    remember numbers = [1, 2, 3, 4, 5];
    remember first = numbers[0];
    remember third = numbers[2];
    remember mixed = [42, "hello", true, 3.14];

    give back first + third;
}

to sum_array(arr: Array) -> Int {
    remember total = 0;
    remember i = 0;

    repeat 5 times {
        remember total = total + arr[i];
        remember i = i + 1;
    }

    give back total;
}
