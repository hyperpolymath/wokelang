to add(a: Int, b: Int) -> Int {
    give back a + b;
}

to multiply(a: Int, b: Int) -> Int {
    give back a * b;
}

to square(n: Int) -> Int {
    give back multiply(n, n);
}

to main() {
    remember x = 5;
    remember y = 3;

    remember sum = add(x, y);
    remember product = multiply(x, y);
    remember squared = square(x);

    give back squared;
}
