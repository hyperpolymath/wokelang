#verbose on;

worker BackgroundWorker {
    print("Worker: Hello from background thread!");
    print("Worker: Doing work...");
    print("Worker: Done!");
}

to main() {
    print("Main: Spawning worker...");

    spawn worker BackgroundWorker;

    print("Main: Worker spawned, waiting...");

    // Simple busy wait to let worker finish
    remember i = 0;
    repeat 1000000 times {
        remember temp = i + 1;
    }

    print("Main: Finished waiting");
    give back 0;
}
