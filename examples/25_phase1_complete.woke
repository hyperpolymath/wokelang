#verbose on;
#care on;

to main() {
    print("=== WokeLang Phase 1 Complete ===");
    print("");

    // Test basic I/O
    remember message = "Hello from WokeLang!";
    print(message);
    print("");

    // Test toString
    remember number = 42;
    remember numberStr = toString(number);
    print("Number as string: " + numberStr);
    print("");

    // Test Result types
    remember okayVal = Okay(100);
    remember oopsVal = Oops("Something went wrong");
    print(toString(okayVal));
    print(toString(oopsVal));
    print("");

    // Test consent system with care mode ON
    print("Requesting file.read permission...");
    only if okay "file.read" {
        print("✓ File read permission granted!");
        remember data = "File contents would go here";
        print("Data: " + data);
    }
    print("");

    // Test with network permission
    print("Requesting network permission...");
    only if okay "network.http" {
        print("✓ Network permission granted!");
        remember url = "https://example.com";
        print("Would fetch: " + url);
    }
    print("");

    print("=== All Phase 1 Features Working! ===");
    give back 0;
}
