// Module import example

use math_utils;

to main() {
    print("Testing module imports:");

    remember x = square(5);
    print("5 squared = " + toString(x));

    remember y = cube(3);
    print("3 cubed = " + toString(y));

    remember z = factorial(5);
    print("5! = " + toString(z));

    give back 0;
}
