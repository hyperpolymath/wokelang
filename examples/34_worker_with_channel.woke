#verbose on;

// Workers communicate through channels that are created in main scope
// This example demonstrates basic worker execution
// For true message passing, channels must be created before spawning
// and passed to workers (channels are thread-safe by design)

worker Calculator {
    remember result = 42 * 2;
    print("Worker calculated: ");
    print(toString(result));
    // Workers execute independently
    give back result;
}

to main() {
    print("Main thread starting...");

    // Spawn the worker - it runs in background
    spawn worker Calculator;

    print("Worker spawned (running in background)");
    print("Main thread continues...");

    // Note: For full message passing, create a channel first:
    // remember ch = std.chan.make(10);
    // Then pass it to the worker and use it for communication

    give back 0;
}
