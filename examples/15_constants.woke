// Constants example
// Demonstrates const declarations

const PI: Float = 3.14159;
const MAX_SIZE: Int = 100;
const APP_NAME: String = "WokeLang";

to main() {
    print("Constants example:");
    print("PI = " + toString(PI));
    print("MAX_SIZE = " + toString(MAX_SIZE));
    print("APP_NAME = " + APP_NAME);

    remember area = PI * 10.0 * 10.0;
    print("Area of circle with radius 10: " + toString(area));

    give back 0;
}
