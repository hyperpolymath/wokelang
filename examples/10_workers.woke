// Worker Concurrency Example
//
// Workers provide lightweight concurrency through message passing.
// Each worker runs in an isolated interpreter instance.

worker DataProcessor {
    remember counter = 0;

    to process(data) {
        remember counter = counter + 1;
        display "Processing item" with counter;
        give back data;
    }
}

worker Logger {
    to log(message) {
        display "LOG:" with message;
        give back message;
    }
}

to main() {
    // Workers are spawned and managed by the runtime
    // The worker system provides:
    // - Isolated execution contexts
    // - Asynchronous message passing
    // - Concurrent execution on a single-threaded LocalSet

    display "Worker example - see tests in src/worker/mod.rs";
    give back 0;
}
