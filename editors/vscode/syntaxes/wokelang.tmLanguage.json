{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WokeLang",
  "scopeName": "source.wokelang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.wokelang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.wokelang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.wokelang",
          "match": "\\b(to|give|back|when|is|otherwise|repeat|times|only|if|okay|attempt|safely|handle|reassure|complain|spawn|thanks|for|each|in|then|measured)\\b"
        },
        {
          "name": "keyword.other.wokelang",
          "match": "\\b(remember|type|use|renamed|as|hello|goodbye|worker|side|quest|superpower)\\b"
        },
        {
          "name": "keyword.operator.logical.wokelang",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.boolean.wokelang",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.wokelang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.wokelang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.wokelang",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.wokelang",
          "match": "\\b(print|println|toString|readLine|Okay|Oops)\\b"
        },
        {
          "name": "support.function.wokelang",
          "match": "\\bstd\\.[a-z]+\\.[a-z_]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.wokelang",
          "match": "(\\+|-|\\*|/|==|!=|<|>|<=|>=|=)"
        }
      ]
    }
  }
}
