# RSR-compliant .gitignore

# OS & Editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
.directory

# Rust
/target/
**/target/
**/*.rs.bk

# Idris2
build/
*.ibc

# Zig

# ReScript

# Dependencies
/vendor/

# Secrets
.env
.env.*
*.pem
*.key
secrets/

# Test/Coverage
/coverage/
htmlcov/

# Logs
*.log
/logs/

# Temp
/tmp/
*.tmp
*.bak

# Crash recovery artifacts
ai-cli-crash-capture/

# Coq build artifacts
*.vo
*.vos
*.vok
*.glob
.*.aux
editors/vscode/lib/

# Native build artifacts
*.wasm
*.so
*.dylib
*.dll

# Coverage / profiling
*.profraw
*.profdata
.coverage/

# OS
.Trash-*/
target/
_build/
.cache/
dist/

# ── Proof-assistant build artefacts ────────────────────────────────────────
# Lean 4 (docs/proofs/verification/) — the .lean sources are tracked, the
# compiled forms are not.
*.olean
*.ilean
*.trace
.lake/

# Idris 2
*.ibc
*.ttc
*.ttm

# ── Exceptions ─────────────────────────────────────────────────────────────
# `*.wasm` is ignored above, but this one is a tracked example fixture.
!examples/math.wasm
