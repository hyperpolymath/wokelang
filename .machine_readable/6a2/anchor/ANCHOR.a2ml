id: "org.hyperpolymath.wokelang"
version: "1.0.0"
clade: "nl"   # nextgen-languages clade (per .machine_readable/CLADE.a2ml)
status: "active"

# SSG Configuration (Unified boj-server build)
ssg:
  engine: "casket"
  output_dir: "public"
  boj_trigger: true
  cartridge: "ssg-mcp"

# Relationships
parents:
  - "org.hyperpolymath.boj-server"          # SSG / publish parent (boj build trigger)
  - "org.hyperpolymath.nextgen-languages"   # nl-clade coordination repo (clade nl) — NOT a code parent; wokelang is standalone
